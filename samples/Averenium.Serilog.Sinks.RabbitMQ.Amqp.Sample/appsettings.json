{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Averenium.Serilog.Sinks.RabbitMQ.Amqp" ],
    "MinimumLevel": "Information",
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "FallbackChain",
        "Args": {
          "configureSink": [
            {
              "Name": "RabbitMQAmqp",
              "Args": {
                "hostnames": [ "localhost:5672" ],
                "username": "sample",
                "password": "sample",
                "exchange": "logs",
                "routingKey": "sample",
                "declareTopology": true,
                "declareQueue": "logs.sample",
                "fallbackAfter": "00:00:30",
                "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
              }
            }
          ],
          "configureFallback": [
            { "Name": "Console" }
          ]
        }
      }
    ]
  }
}
