<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Averenium</Authors>
    <Company>Averenium</Company>
    <Copyright>Copyright © Averenium</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/averenium/Averenium-Serilog-Sink-RabbitMq-AMQP</RepositoryUrl>
    <PackageProjectUrl>https://github.com/averenium/Averenium-Serilog-Sink-RabbitMq-AMQP</PackageProjectUrl>
    <PackageTags>serilog;sink;rabbitmq;amqp;amqp10;logging</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="SourceLink">
    <!-- The .NET SDK includes SourceLink: the repository URL and commit come from git; sources are linked in the .snupkg. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Deterministic paths in CI builds (GitHub Actions sets GITHUB_ACTIONS=true). -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
